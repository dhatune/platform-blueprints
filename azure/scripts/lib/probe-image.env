# Shared identity for the egress-probe image, sourced by scripts/session-up.sh
# (which imports it) and by scripts/verify/01, 06 and 08 (which run it).
#
# The Basic-tier firewall allows exactly the AzureCloud.<region> service tag
# and the AzureKubernetesService FQDN tag -- Docker Hub is not on either list,
# deliberately: images come from this landing zone's own registry, and that
# removal is what makes the Basic tier sufficient. A probe pod that tries to
# `docker pull curlimages/curl` straight from Docker Hub therefore never
# starts, which produces the worst kind of false result: a check whose
# negative half expects the pull to be blocked "passes" for entirely the
# wrong reason, while its positive half fails.
#
# So the probe image is imported into the registry once, by session-up.sh,
# and the verify scripts pull it from there -- a path the firewall already
# permits (see modules/acr's private endpoint). This also means the probe's
# own arrival is itself evidence for check 5: pulling it exercises the same
# private-endpoint path and the same kubelet managed identity that check 5
# tests directly.
#
# Named once, here, so the importer and the three consumers can never drift
# apart on repository or tag.
#
# The source belongs here too: if it stayed hardcoded in session-up.sh,
# changing the image here would change what the verify scripts ask for and
# not what the importer puts in the registry.
PROBE_IMAGE_REPOSITORY="verify-probe"
PROBE_IMAGE_TAG="curl"

# The source is quay.io rather than Docker Hub: az acr import pulls from
# Azure's shared egress, which Docker Hub rate-limits anonymously, so the
# import itself fails there often enough to block a session.
# Pinned by digest for reproducibility (current as of 2026-09-25).
PROBE_IMAGE_SOURCE="quay.io/curl/curl@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777"

# Runs a short-lived probe pod inside the cluster and prints its logs.
#
# The pod is created, waited on until it has finished, and only then read.
# Attaching to it instead (`kubectl run --rm -i`) loses the output whenever
# the pod ends before kubectl attaches, and a lost output reads exactly like a
# refused connection: a check whose negative half expects a refusal would then
# pass for no reason at all. Logs of a finished pod are kept until it is
# deleted, so reading them afterwards cannot race. The last line printed is
# always "probe-phase: <phase>", so a caller can tell a pod that never ran
# from one that ran and failed.
#
# Requires $rg and $cluster. Usage: probe_pod_output <name> <image> <arg>...
probe_pod_output() {
  local name="$1" image="$2"
  shift 2
  local dir manifest
  dir="$(mktemp -d)"
  manifest="$dir/$name.yaml"
  {
    echo "apiVersion: v1"
    echo "kind: Pod"
    echo "metadata:"
    echo "  name: $name"
    echo "spec:"
    echo "  restartPolicy: Never"
    echo "  containers:"
    echo "  - name: probe"
    echo "    image: $image"
    echo "    args:"
    local a
    for a in "$@"; do
      printf '    - %s\n' "$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$a")"
    done
  } >"$manifest"
  az aks command invoke -g "$rg" -n "$cluster" --file "$manifest" \
    --command "kubectl delete pod $name --ignore-not-found >/dev/null 2>&1; kubectl apply -f $name.yaml >/dev/null && p=Pending; for i in \$(seq 1 60); do p=\$(kubectl get pod $name -o jsonpath='{.status.phase}'); if [ \"\$p\" = Succeeded ] || [ \"\$p\" = Failed ]; then break; fi; sleep 2; done; kubectl logs $name 2>&1; echo; echo \"probe-phase: \$p\"; kubectl delete pod $name --wait=false >/dev/null 2>&1" \
    --query "logs" -o tsv 2>&1
  rm -f "$manifest"
  rmdir "$dir" 2>/dev/null
}

# The HTTP status curl printed with -w '%{http_code}', or nothing if the probe
# produced no status at all. "000" means curl got no response.
http_code_of() {
  echo "$1" | grep -oE '(^|[^0-9])[0-9]{3}$' | grep -oE '[0-9]{3}' | head -1
}

# Confirms the probe image is in the registry by pulling it from inside the
# cluster. Asking the registry directly from the operator's machine cannot
# work: the registry is closed to the public network by design, so that query
# fails whether or not the image is there.
#
# Usage: probe_image_present <resource-group> <cluster> <image>
probe_image_present() {
  local out
  out="$(rg="$1" cluster="$2" probe_pod_output "probe-presence-$RANDOM" "$3" --version)"
  if echo "$out" | grep -q 'Forbidden'; then
    echo "FAIL: the cluster refused the call (Forbidden). The identity running this"
    echo "      script needs 'Azure Kubernetes Service RBAC Cluster Admin' on the"
    echo "      cluster; live/lab/20-workload grants it to whoever applies the stack,"
    echo "      and a new assignment can take a few minutes to take effect."
    return 1
  fi
  echo "$out" | grep -qE 'curl [0-9]+\.'
}

# The copy tool check 5 runs inside the cluster to push an image through the
# private endpoint. Imported alongside the probe for the same reason: the
# firewall permits our own registry, not the public one it comes from.
# Pinned by digest for reproducibility (current as of 2026-09-25).
SKOPEO_IMAGE_SOURCE="quay.io/skopeo/stable@sha256:064d2cefb512c97d5a22979599ca05b7198fd6176494a634e1f31bd6b5fbd77a"
SKOPEO_IMAGE_REPOSITORY="verify-skopeo"
SKOPEO_IMAGE_TAG="stable"
