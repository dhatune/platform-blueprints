# Shared identity of the ingress controller, sourced by scripts/ingress/
# install-nginx.sh. Everything the importer and the manifest renderer must
# agree on is named once, here.
#
# WHY THE IMAGES ARE IMPORTED AT ALL
#
# The firewall permits exactly the AzureCloud.<region> service tag and the
# AzureKubernetesService FQDN tag. The registry the ingress controller
# publishes to is on neither list, deliberately -- removing the public
# registries is what makes the Basic tier sufficient. A manifest pointing at
# the upstream registry produces pods that never start, and the reason is not
# in any of their events beyond a pull timeout.
#
# So the images are imported into this landing zone's own registry, once, and
# the manifest is rewritten to point there. `az acr import` is a control-plane
# call: the registry service performs the pull server-side, so this works from
# a machine that has no data-plane access to the registry and no container
# runtime.
#
# THE SOURCE IS NAMED HERE TOO
#
# A file that names the destination repository and tag but leaves the source
# image hardcoded in the importer is half a source of truth: the next person
# changes the version here and the importer keeps pulling the old one,
# silently.
INGRESS_UPSTREAM_REGISTRY="registry.k8s.io"

# Pinned by digest, not by tag. A tag is a moving pointer; the digest is the
# image. Importing by digest means the copy in our registry is provably the
# artefact this manifest was reviewed against, and a retag upstream cannot
# change what we run.
INGRESS_CONTROLLER_VERSION="v1.12.1"
INGRESS_CONTROLLER_DIGEST="sha256:d2fbc4ec70d8aa2050dd91a91506e998765e86c96f32cffb56c503c9c34eed5b"
INGRESS_CERTGEN_VERSION="v1.5.2"
INGRESS_CERTGEN_DIGEST="sha256:e8825994b7a2c7497375a9b945f386506ca6a3eda80b89b74ef2db743f66a5ea"

# Repository paths inside our own registry. Kept identical to the upstream
# paths so a reader comparing the rendered manifest against the vendored one
# sees only the registry host change.
INGRESS_CONTROLLER_REPOSITORY="ingress-nginx/controller"
INGRESS_CERTGEN_REPOSITORY="ingress-nginx/kube-webhook-certgen"

# The vendored upstream manifest this renders from. Vendored rather than
# fetched at run time so the cluster's contents do not depend on a network
# call succeeding, and so a change to it shows up in review as a diff.
INGRESS_MANIFEST="ingress-nginx-v1.12.1.yaml"

# Private address the controller's load balancer holds. MUST equal
# var.ingress_internal_address in live/lab/20-workload, which is what the
# firewall's translation rule points at. Two systems that never talk to each
# other -- Terraform and Kubernetes -- have to agree on this number, and the
# only agreement that survives a redeploy of either is one both are told.
INGRESS_INTERNAL_ADDRESS="10.61.1.240"
