# Copy to .env and fill in. .env is ignored by git. Never commit real values.

# --- Google Cloud ---
# Account that runs gcloud and Terraform (a token is minted from it; ADC is never used).
GCP_ACCOUNT=
PROJECT_ID=
REGION=us-east1
ZONE=us-east1-b
BILLING_ACCOUNT=
# Folder that will hold the project (numeric id).
FOLDER_ID=
# Comma-separated ranges allowed to the AAP UI, each /28 or narrower.
# Empty = your current public IP as /32.
ADMIN_CIDRS=
# SSH key pair for managed nodes, generated outside the repository.
SSH_KEY_PATH=~/.aap-lab/id_ed25519

# --- Your Git repository (a fork of this blueprint) ---
# The automation controller and EDA sync playbooks and rulebooks from it,
# with a read-only deploy key stored at ~/.aap-lab/deploy_key.
AAP_PROJECT_SCM_URL=

# --- Red Hat ---
# Path to the containerized setup tarball downloaded from access.redhat.com.
AAP_SETUP_TARBALL=
# Registry Service Account (access.redhat.com/terms-based-registry).
# The username contains "|": keep it between single quotes.
REDHAT_REGISTRY_USERNAME=
REDHAT_REGISTRY_PASSWORD=
# Offline token from console.redhat.com/ansible/automation-hub/token
AH_TOKEN=

# --- AAP platform (filled after `make up`) ---
# Public IP of aap-01 (terraform output aap_public_ip).
AAP_HOST=
# Private IP of aap-01 (terraform output aap_internal_ip), used by managed nodes.
AAP_INTERNAL_IP=
AAP_ADMIN_PASSWORD=
AAP_PG_PASSWORD=

# --- Demo users (RBAC) and EDA service user ---
USER_PASSWORD_OP1=
USER_PASSWORD_SEC1=
USER_PASSWORD_AUD1=
USER_PASSWORD_EDA=
