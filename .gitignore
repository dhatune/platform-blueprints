# Secrets and local config — never commit
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# SSH and GPG keys have no extension, so match them by name
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
!*.pub
*.gpg
*.asc
.netrc
.npmrc
.pypirc

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Lock files belong to a root module — the directory Terraform is actually run
# in. A child module never has one read from it, so any lock file appearing
# under modules/ is a leftover from running init there to validate, and
# committing it implies a guarantee that nothing enforces.
#
# This is narrow on purpose. The lock file of a root module is committed, and
# that rule is not weakened here.
landing-zone/modules/*/.terraform.lock.hcl
platform/*/dns/.terraform.lock.hcl
