# Secrets and local config — never commit
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# SSH and GPG keys have no extension, so match them by name
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
!*.pub
*.gpg
*.asc
.netrc
.npmrc
.pypirc

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Editors and OS
.DS_Store
.idea/
.vscode/
