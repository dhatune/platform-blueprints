# Copy to values.env, which is not in version control.
# Fill from: terraform -chdir=../../../../lab output -json environments

# The names this environment serves, as one wildcard. A certificate for it can
# only be obtained by writing DNS, which is what ADR 25 already chose.
wildcard=*.prod.lab.example.test

# The subtree the record publisher may write into, and nothing wider. This is
# the only thing keeping it away from the rest of the zone.
domainFilter=prod.lab.example.test

# The project holding the zone. Usually not this environment's project.
dnsProject=example-dns-project

# Unique per cluster. If development and production share this, the two
# controllers claim each other's ownership records and fight over every name.
txtOwnerId=example-prod

# The identity both controllers assume. No key.
dnsServiceAccount=sa-dns@example-prod.iam.gserviceaccount.com

# An address somebody reads. The certificate authority writes to it before a
# certificate expires and it is the only warning there is.
acmeEmail=platform@example.test
