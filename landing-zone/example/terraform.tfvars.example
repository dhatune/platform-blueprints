# Copy to terraform.tfvars and replace with your own values.
# terraform.tfvars is excluded from version control; this file is not.
#
# Every value below is fictional. A real organization or billing identifier in
# a public repository is free reconnaissance for an attacker.

organization_id = "000000000000"
billing_account = "000000-000000-000000"
quota_project   = "example-bootstrap"
region          = "us-east1"
project_prefix  = "example"

# Cloud Identity customer IDs, not domains. Find yours with:
#   gcloud organizations describe <org id> --format="value(owner.directoryCustomerId)"
allowed_customer_ids = ["C01example"]

applier_service_account = "sa-apply@example-bootstrap.iam.gserviceaccount.com"
